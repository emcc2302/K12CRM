# =======================================================
# EdTech CRM & Inquiry System - Root Environment Template
# =======================================================

# --- BACKEND ENVIRONMENT VARIABLES ---
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Connection URI
# Found in: Supabase Dashboard -> Settings -> Database -> Connection String (URI / Pooler)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# JWT Secret for Custom Admin Authentication
JWT_SECRET=super_secret_jwt_key_for_edtech_crm_assessment_2026

# Default Initial Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Admin User

# --- FRONTEND ENVIRONMENT VARIABLES ---
# Base API URL used by the React application
VITE_API_BASE_URL=http://localhost:5000/api
